# Copy this file to .env for local development and fill in real values.
# NEVER commit the real .env file — it is already in .gitignore.
# In production (Railway/Vercel), these are set in that platform's
# "Environment Variables" dashboard, not in a file at all.

# --- Database ---
# Local dev (docker-compose): postgresql+asyncpg://flagfix:flagfix@localhost:5432/flagfix
# Railway: copy the value Railway generates for you, just add "+asyncpg" after "postgresql"
DATABASE_URL=postgresql+asyncpg://flagfix:flagfix@localhost:5432/flagfix

# --- Redis (background jobs) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI providers ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
VOYAGE_API_KEY=pa-...
VOYAGE_EMBED_MODEL=voyage-3.5-lite

# --- Object storage (Cloudflare R2, S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flagfix-attachments

# --- Email (Resend) ---
RESEND_API_KEY=

# --- App ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
